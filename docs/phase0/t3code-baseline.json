{
 "subject": "t3code desktop (Electron) resource baseline",
 "date": "2026-10-03",
 "method_kind": "electron",
 "proxy": false,
 "versions": {
  "t3code_commit": "8ed276c246b624631e7d39241ebfd22d8314cb68",
  "t3code_version": "0.0.45 (@t3tools/desktop, t3 server)",
  "electron": "44.4.2",
  "chromium": "152.0.7977.130",
  "electron_node": "24.21.0",
  "build_node": "24.21.0",
  "pnpm": "11.10.0",
  "claude_agent_sdk": "0.3.276"
 },
 "build": "pnpm install (filtered to root, desktop, server(t3), web, scripts); `vp run --filter @t3tools/desktop --filter t3 build` (production vite build of apps/web, server bundle apps/server/dist, Electron main bundle apps/desktop/dist-electron). Launched the way `start:desktop` does: `electron dist-electron/main.cjs --no-sandbox` from apps/desktop (unpackaged, not the AppImage).",
 "environment": {
  "cpu_cores": 4,
  "ram_gb": 15,
  "display": "Xvfb :97 1920x1080x24, no window manager; app window resized to 1280x800 with xdotool",
  "rendering": "software: GPU process loaded Mesa GLX/gallium (llvmpipe) - no hardware GPU",
  "isolation": "env -i with HOME=T3CODE_HOME-parent=/home/claude/t3-profile-home, T3CODE_HOME=/home/claude/t3-profile-home/.t3, XDG_* under it, T3CODE_PORT=3799 (port scan fails without IPv6), no credentials in env",
  "concurrent_load": "two cargo builds on the box; loadavg ~0.4-1.7 during measurements"
 },
 "sampling": {
  "interval_ms": 500,
  "source": "/proc/<pid>/status VmRSS, /proc/<pid>/smaps_rollup Pss, /proc/<pid>/stat utime+stime",
  "tree": "all descendants of the Electron main PID (main, 2 zygotes, gpu-process, renderer, network utility, server = electron-as-node running apps/server/dist/bin.mjs, provider CLI subprocesses)",
  "cpu_pct_unit": "percent of one core (100 = one full core); 500 ms x 100 Hz ticks gives 2% granularity per process"
 },
 "workload": {
  "idle": "fresh profile, onboarding completed, project 'demo' (tiny git repo) added, empty New thread view; 10 s settle then 20 s measure",
  "stream": "one turn typed into the composer via xdotool ('Write a Rust ownership tutorial'). Claude provider binaryPath -> fake CLI (/home/claude/t3-profile-home/fake-claude.py) that answers SDK control_request frames (initialize etc.) and replays resource-stream.jsonl (7 thinking + 437 text deltas, 52 KB markdown) at 40 ms as stream_event frames + one `assistant` snapshot per completed content block + `result`, i.e. the real CLI's --include-partial-messages shape. It also answers `claude -p --json-schema` metadata calls (thread title) after 1.2 s. stream phase = send -> fake emitted result (~18 s); settled = following 15 s.",
  "settings": {
   "providers.claudeAgent.binaryPath": "fake-claude.py",
   "providers.codex.enabled": false
  }
 },
